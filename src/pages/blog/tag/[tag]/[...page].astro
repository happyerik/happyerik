---
import BaseLayout from "@layouts/BaseLayout.astro";
import PostList from "@components/PostList.astro";
import TagBar from "@components/TagBar.astro";
import Pagination from "@components/Pagination.astro";
import { getSortedPosts } from "../../../../lib/posts";

export async function getStaticPaths({ paginate }) {
  const all_posts = await getSortedPosts();
  const all_tags = [...new Set(all_posts.flatMap((post) => post.data.tags || []))];

  return all_tags.flatMap((tag) => {
    const filtred_posts = all_posts.filter((post) => post.data.tags?.includes(tag));
    return paginate(filtred_posts, {
      params: { tag },
      pageSize: 10,
    });
  });
}

const { page } = Astro.props;
const params = Astro.params;
---

<BaseLayout title={"博客 - " + params.tag} sideBarActiveItemID="blog">
  <h1 class="text-3xl font-bold tracking-tight">
    <span class="text-base-content/40">#</span>{params.tag}
  </h1>
  <p class="mt-2 mb-6 text-base-content/60">共 {page.total} 篇文章</p>
  <TagBar activeTag={params.tag} />

  <PostList posts={page.data} groupByYear />

  <Pagination prev={page.url.prev} next={page.url.next} />
</BaseLayout>
