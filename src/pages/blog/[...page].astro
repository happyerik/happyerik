---
import BaseLayout from "../../layouts/BaseLayout.astro";
import PostList from "../../components/PostList.astro";
import TagBar from "../../components/TagBar.astro";
import Pagination from "../../components/Pagination.astro";
import { getSortedPosts } from "../../lib/posts";

export async function getStaticPaths({ paginate }) {
  const posts = await getSortedPosts();
  return paginate(posts, { pageSize: 10 });
}

const { page } = Astro.props;
---

<BaseLayout title="博客" sideBarActiveItemID="blog">
  <h1 class="text-3xl font-bold tracking-tight">博客</h1>
  <p class="mt-2 mb-6 text-base-content/60">技术笔记，也有一些日常的想法。</p>
  <TagBar />

  {
    page.data.length === 0 ? (
      <p class="text-base-content/60">目前还没有文章，请稍后再来。</p>
    ) : (
      <PostList posts={page.data} groupByYear />
    )
  }

  <Pagination prev={page.url.prev} next={page.url.next} />
</BaseLayout>
