---
import BaseLayout from "../layouts/BaseLayout.astro";
import ProjectCard from "../components/ProjectCard.astro";
import { apps } from "../data/apps";
---

<BaseLayout title="应用" sideBarActiveItemID="apps">
  <h1 class="text-3xl font-bold tracking-tight">应用</h1>
  <p class="mt-2 mb-8 text-base-content/60">一些参与的有意思的应用</p>

  <div class="grid gap-3">
    {apps.map((app, i) => <div class="reveal" style={`--i: ${i}`}><ProjectCard {...app} /></div>)}
  </div>
</BaseLayout>
