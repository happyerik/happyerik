---
import BaseLayout from "../layouts/BaseLayout.astro";
import ProjectCard from "../components/ProjectCard.astro";
import { projects } from "../data/projects";
---

<BaseLayout title="项目" sideBarActiveItemID="projects">
  <h1 class="text-3xl font-bold tracking-tight">项目</h1>
  <p class="mt-2 mb-8 text-base-content/60">参与过的一些研究与工程项目。</p>

  <div class="grid gap-3">
    {projects.map((p, i) => <div class="reveal" style={`--i: ${i}`}><ProjectCard {...p} /></div>)}
  </div>
</BaseLayout>
