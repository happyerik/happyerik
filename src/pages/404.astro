---
import BaseLayout from "../layouts/BaseLayout.astro";
const base = import.meta.env.BASE_URL.replace(/\/?$/, '/');
---

<BaseLayout title="404：页面未找到">
  <div class="py-12 text-center sm:py-16">
    <!-- 彩蛋：首页的猫猫点云在这里散架了；鼠标靠近会吸回一部分，按住整只拼回来。不支持 WebGL 或偏好减少动效时显示静态照片 -->
    <div class="relative mx-auto h-[240px] w-[240px] select-none touch-none sm:h-[300px] sm:w-[300px]" data-photo={`${base}chali.jpg`} id="lost-cloud-wrap">
      <img
        id="lost-photo"
        width={300}
        height={300}
        src={`${base}chali.jpg`}
        alt="一只猫"
        class="absolute inset-[9%] h-[82%] w-[82%] rounded-full object-cover ring-1 ring-base-content/10 transition-opacity duration-700"
      />
      <canvas id="lost-cloud" class="absolute inset-0 h-full w-full cursor-grab opacity-0 transition-opacity duration-500 active:cursor-grabbing" aria-hidden="true"></canvas>
    </div>

    <h1 class="mt-6 text-5xl font-bold tabular-nums tracking-tight">404</h1>
    <a class="btn btn-primary btn-sm mt-8" href={base}>回到首页</a>
  </div>

  <script>
    import { mountCatCloud } from "../scripts/catCloud";

    let destroy: (() => void) | null = null;
    let generation = 0; // 异步加载期间若已换页，丢弃这次初始化

    document.addEventListener("astro:page-load", async () => {
      const wrap = document.getElementById("lost-cloud-wrap");
      const canvas = document.getElementById("lost-cloud") as HTMLCanvasElement | null;
      const photo = document.getElementById("lost-photo");
      if (!wrap || !canvas || !photo) return;
      if (window.matchMedia("(prefers-reduced-motion: reduce)").matches) return;

      const current = ++generation;
      try {
        const dispose = await mountCatCloud(
          canvas,
          wrap.dataset.photo!,
          () => {
            canvas.style.opacity = "1";
            photo.style.opacity = "0";
          },
          { scattered: true },
        );
        if (current === generation) destroy = dispose;
        else dispose?.();
      } catch (err) {
        console.error("点云初始化失败，保留静态照片", err);
      }
    });

    document.addEventListener("astro:before-swap", () => {
      generation++;
      destroy?.();
      destroy = null;
    });
  </script>
</BaseLayout>
