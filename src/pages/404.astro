---
import BaseLayout from "../layouts/BaseLayout.astro";
const base = import.meta.env.BASE_URL;
---

<BaseLayout title="404：页面未找到">
  <div class="py-20 text-center">
    <div class="text-6xl">🏝</div>
    <h1 class="mt-6 text-5xl font-bold tabular-nums tracking-tight">404</h1>
    <p class="mt-3 text-base-content/60">您要找的页面不存在。</p>
    <a class="btn btn-primary btn-sm mt-8" href={base}>回到首页</a>
  </div>
</BaseLayout>
