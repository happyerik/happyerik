---
import { getSortedPosts } from "../lib/posts";

const { activeTag } = Astro.props;
const base = import.meta.env.BASE_URL.replace(/\/?$/, '/');

const posts = await getSortedPosts();
const counts = new Map<string, number>();
for (const tag of posts.flatMap((p) => p.data.tags || [])) {
  counts.set(tag, (counts.get(tag) || 0) + 1);
}
const tags = [...counts.entries()].sort((a, b) => b[1] - a[1]);

const chip = "rounded-full px-2.5 py-0.5 text-[13px] transition-colors";
const idle = "bg-base-200 text-base-content/65 hover:bg-base-300 hover:text-base-content";
const active = "bg-primary text-primary-content";
---

<div class="mb-10 flex flex-wrap gap-1.5">
  <a href={`${base}blog/`} class:list={[chip, activeTag ? idle : active]}>全部 <span class="opacity-60">{posts.length}</span></a>
  {
    tags.map(([tag, n]) => (
      <a href={`${base}blog/tag/${tag}`} class:list={[chip, tag === activeTag ? active : idle]}>
        {tag} <span class="opacity-60">{n}</span>
      </a>
    ))
  }
</div>
