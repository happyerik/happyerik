---
const { activeItemID } = Astro.props;
const base = import.meta.env.BASE_URL.replace(/\/?$/, '/');

const navItems = [
  { id: "home", label: "首页", href: base },
  { id: "blog", label: "博客", href: `${base}blog/` },
  { id: "projects", label: "项目", href: `${base}projects` },
];
---

<header transition:name="site-header" transition:animate="none" class="sticky top-0 z-30 border-b border-base-content/5 bg-base-100/55 backdrop-blur-md">
  <div class="mx-auto flex h-16 max-w-3xl items-center justify-between px-5 md:px-6">
    {/* 首页正文已有头像和名字，顶栏就不再重复显示 */}
    {
      activeItemID === "home" ? (
        <span />
      ) : (
        <a href={base} class="group flex shrink-0 items-center gap-2.5" aria-label="返回首页">
          <img
            src={`${base}chali.jpg`}
            width="32"
            height="32"
            alt=""
            class="h-8 w-8 shrink-0 rounded-full object-cover ring-1 ring-base-content/10 transition group-hover:ring-primary/50"
          />
          <span class="whitespace-nowrap font-semibold tracking-tight">张勇</span>
        </a>
      )
    }

    <nav class="flex items-center gap-0.5 text-[15px] sm:gap-1">
      {
        navItems.map((item) => (
          <a
            href={item.href}
            class:list={[
              "whitespace-nowrap rounded-md px-2.5 py-1.5 transition-colors sm:px-3",
              item.id === activeItemID
                ? "text-base-content font-medium bg-base-200"
                : "text-base-content/60 hover:text-base-content",
            ]}
            aria-current={item.id === activeItemID ? "page" : undefined}
          >
            {item.label}
          </a>
        ))
      }
      <button
        id="theme-toggle"
        type="button"
        class="ml-1 shrink-0 rounded-md p-2 text-base-content/60 transition-colors hover:bg-base-200 hover:text-base-content"
        aria-label="切换深浅色"
        title="切换深浅色"
      >
        <svg class="theme-icon-sun h-[18px] w-[18px]" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
          <circle cx="12" cy="12" r="4" /><path d="M12 2v2M12 20v2M4.93 4.93l1.41 1.41M17.66 17.66l1.41 1.41M2 12h2M20 12h2M6.34 17.66l-1.41 1.41M19.07 4.93l-1.41 1.41" />
        </svg>
        <svg class="theme-icon-moon h-[18px] w-[18px]" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
          <path d="M21 12.79A9 9 0 1 1 11.21 3 7 7 0 0 0 21 12.79z" />
        </svg>
      </button>
    </nav>
  </div>
</header>

<style>
  :global([data-theme="paper"]) .theme-icon-sun,
  :global([data-theme="ink"]) .theme-icon-moon {
    display: none;
  }
</style>
