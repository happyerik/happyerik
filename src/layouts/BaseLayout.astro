---
import BaseHead from "../components/BaseHead.astro";
import Header from "../components/Header.astro";
import { ViewTransitions } from "astro:transitions";

import { SITE_TITLE, SITE_DESCRIPTION, TRANSITION_API } from "../config";

const {
  image,
  title = SITE_TITLE,
  description = SITE_DESCRIPTION,
  sideBarActiveItemID,
  ogType,
} = Astro.props;

// 换页时正文淡出、新页面轻轻上滑淡入；关键帧定义在 global.css
const easeOut = "cubic-bezier(0.2, 0.7, 0.2, 1)";
const pageAnim = {
  old: { name: "fade-out", duration: "120ms", easing: "ease-in", fillMode: "both" },
  new: { name: "fade-up", duration: "320ms", delay: "60ms", easing: easeOut, fillMode: "both" },
};
const pageTransition = { forwards: pageAnim, backwards: pageAnim };
---

<!doctype html>
<html lang="zh-CN" data-theme="paper">
  <head>
    <BaseHead title={title} description={description} image={image} ogType={ogType} />
    <!-- 尽早确定主题，避免深色模式下首屏闪白；ViewTransitions 换页后需要重新应用 -->
    <script is:inline>
      (() => {
        const apply = (doc) => {
          let theme = null;
          try { theme = localStorage.getItem("theme"); } catch {}
          if (theme !== "paper" && theme !== "ink") {
            theme = matchMedia("(prefers-color-scheme: dark)").matches ? "ink" : "paper";
          }
          doc.documentElement.dataset.theme = theme;
        };
        apply(document);
        document.addEventListener("astro:before-swap", (e) => apply(e.newDocument));
      })();
    </script>
    {TRANSITION_API && <ViewTransitions />}
  </head>
  <body class="flex min-h-screen flex-col bg-base-100 text-base-content">
    <Header activeItemID={sideBarActiveItemID} />
    <main
      class="mx-auto w-full max-w-3xl flex-1 px-5 pb-24 pt-10 md:px-6 md:pt-14"
      transition:name="page-main"
      transition:animate={pageTransition}
    >
      <slot />
    </main>
    <script>
      const bindThemeToggle = () => {
        document.getElementById("theme-toggle")?.addEventListener("click", () => {
          const next = document.documentElement.dataset.theme === "ink" ? "paper" : "ink";
          document.documentElement.dataset.theme = next;
          document.documentElement.toggleAttribute("data-theme-anim", true);
          try { localStorage.setItem("theme", next); } catch {}
          // 同步 giscus 评论区的主题
          document.querySelector<HTMLIFrameElement>("iframe.giscus-frame")?.contentWindow?.postMessage(
            { giscus: { setConfig: { theme: next === "ink" ? "transparent_dark" : "light" } } },
            "https://giscus.app"
          );
        });
      };
      bindThemeToggle();
      document.addEventListener("astro:after-swap", bindThemeToggle);
    </script>
  </body>
</html>
